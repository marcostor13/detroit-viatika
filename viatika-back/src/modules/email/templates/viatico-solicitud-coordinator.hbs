{{> email-header}}
      <span class="badge badge-info">Pendiente de aprobación</span>
      {{#if esCajaChica}}
      <h1 class="title">Nueva solicitud de caja chica</h1>
      <p>Estimado/a <strong>{{coordinatorName}}</strong>,</p>
      <p><strong>{{collaboratorName}}</strong> solicita un presupuesto de caja chica y requiere su aprobación.</p>
      {{else}}
      <h1 class="title">Nueva solicitud de fondos</h1>
      <p>Estimado/a <strong>{{coordinatorName}}</strong>,</p>
      <p>El colaborador <strong>{{collaboratorName}}</strong> ha enviado una nueva solicitud de fondos que requiere su revisión.</p>
      {{/if}}

      <p class="label">Detalles rápidos:</p>
      <div class="box">
        {{#if projectLabel}}<div class="row"><strong>Centro de costo:</strong> {{projectLabel}}</div>{{/if}}
        <div class="row"><strong>Colaborador:</strong> {{collaboratorName}}</div>
        {{#if esCajaChica}}
        <!-- La caja chica no tiene destino ni fechas: esas filas salían vacías.
             El monto es el PRESUPUESTO pedido, no la diferencia a depositar,
             que es lo que el aprobador está autorizando. -->
        <div class="row"><strong>Presupuesto solicitado:</strong> {{currencySymbol}} {{totalFormatted}}</div>
        {{#if presupuestoAnteriorFormatted}}<div class="row"><strong>Presupuesto vigente:</strong> {{currencySymbol}} {{presupuestoAnteriorFormatted}}</div>{{/if}}
        {{else}}
        <div class="row"><strong>Lugar:</strong> {{place}}</div>
        <div class="row"><strong>Fechas:</strong> {{startDate}} al {{endDate}}</div>
        <div class="row"><strong>Monto total:</strong> {{currencySymbol}} {{totalFormatted}}</div>
        {{/if}}
      </div>

      <div class="btn-container">
        <a href="{{platformUrl}}" class="btn">Ir a la plataforma</a>
      </div>
{{> email-footer}}
