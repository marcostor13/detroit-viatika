# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Google OAuth (si se usa login con Google)
CLIENT_ID=
CLIENT_SECRET=

# App
PORT=3016
PASSRAMDOM=
JWT_SECRET=

# Email (Nodemailer)
# EMAIL_PROVIDER: gmail | outlook  (default: outlook)
EMAIL_PROVIDER=outlook
# USER_EMAIL: la cuenta de correo desde la que se envían los emails
USER_EMAIL=
# PASSWORD_EMAIL:
#   Gmail   -> App Password (16 chars, sin espacios). Requiere 2FA activo.
#              Generar en: https://myaccount.google.com/apppasswords
#   Outlook -> App Password si la cuenta tiene MFA activo.
#              Generar en: https://account.microsoft.com/security > Opciones avanzadas > Contraseñas de aplicación
#              Si NO tiene MFA, usar la contraseña normal de la cuenta Microsoft.
PASSWORD_EMAIL=
# EMAILS_ENABLED: true | false  (false desactiva el envío sin cambiar código)
EMAILS_ENABLED=true

# Enlaces de los correos (VD-119). Sin estas variables se usan los valores por
# defecto de src/modules/email/email.service.ts, hoy https://rendiciones.detroit.pe.
# APP_PUBLIC_URL: front al que apunta el botón «Ir a la plataforma» cuando la
#   petición no trae un origen permitido (recordatorios programados, scripts).
APP_PUBLIC_URL=
# APP_ALLOWED_ORIGINS: lista separada por comas de orígenes de front a los que
#   se permite enlazar. Si se define, reemplaza a la lista integrada en código.
#   Un dominio nuevo de front debe añadirse aquí, o el correo enlazará al de por
#   defecto en vez de al que usó el colaborador.
APP_ALLOWED_ORIGINS=
# APP_LOGO_URL: logo de cabecera de los correos. Debe ser absoluta y pública.
APP_LOGO_URL=

# OpenAI
OPENAI_API_KEY=

# AWS S3
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2

# DNS (requerido en algunos entornos para resolver hosts externos)
NODE_DNS_SERVERS=8.8.8.8,1.1.1.1

# GitHub Personal Access Token (si se usa alguna integración con GitHub)
GHP_TOKEN=

# Scheduler — test de notificaciones
# Clave para el endpoint POST /api/scheduler/test-notifications (sin JWT).
# Si no se define, el endpoint queda deshabilitado. Usar cualquier string seguro.
SCHEDULER_TEST_KEY=
